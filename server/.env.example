# CloudLoom 后端环境变量
# 复制为 server/.env 后填写。**本文件不含任何真实凭据。**
# 说明：所有变量在 src/config.js 里都有默认值，只有 JWT_SECRET 是必填。

# ===== 必填 =====
# JWT 签名密钥。请换成一串足够长的随机值（例如 openssl rand -hex 32 的输出）
JWT_SECRET=change-me-to-a-long-random-string

# ===== 可选：Agent 懒启动与巡检 =====
# 空闲多久后自动停掉 Agent（毫秒），默认 30 分钟
IDLE_STOP_MS=1800000
# 巡检间隔（毫秒），默认 5 分钟
SWEEP_INTERVAL_MS=300000

# ===== 可选：用量计费常量（美元 / 百万 tokens）=====
# 默认值与项目文档中的价目快照一致；价目变动时改这里即可
PRICE_IN_PER_M=0.14
PRICE_OUT_PER_M=0.28
PRICE_CACHE_READ_PER_M=0.0028
# 仅用于把估算美元折成人民币展示（固定汇率，非实时行情）
USD_CNY=7.2
# 上游没有回 usage 时的字符→token 经验系数（兜底路径）
USAGE_EST_CHARS_PER_TOKEN_CJK=1.5
USAGE_EST_CHARS_PER_TOKEN_ASCII=4

# ===== 可选：长会话上下文瘦身 =====
# 默认只带最近 12 轮；设为 0 或负数 = 关闭裁剪（仅供实测对照）
CHAT_HISTORY_MAX_ROUNDS=12
# 被裁掉的早期部分改由 Agent 生成一次摘要并复用（默认关；开启后摘要本身也花 token）
CHAT_SUMMARY_ENABLED=0

# ===== 可选：注册策略 =====
# open     = 公开注册，注册即成 active 并自动登录（默认）
# approval = 需管理员批准后才可登录（原行为）
REGISTER_MODE=open
# 全局每小时最多注册数（进程内计数，重启清零）；0 = 不限制
REGISTER_MAX_PER_HOUR=20

# ===== 可选：看板数据库位置 =====
# 默认 /root/.hermes/kanban.db
# HERMES_KANBAN_BOARD=default
